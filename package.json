    "test:performance": "node --experimental-strip-types scripts/performance.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "csv-parse": "^7.0.3",
