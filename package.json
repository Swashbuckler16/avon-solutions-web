    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.17",
    "sharp": "^0.35.5",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
